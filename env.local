# =============================================================================
# Aunties Tykes — Environment Variables (template)
# =============================================================================
# Copy to `.env.local` for local dev — Vite auto-loads it and it's already
# git-ignored (see .gitignore: .env, .env.local, .env.*.local are all listed).
# In Vercel, set these under Project Settings → Environment Variables. Never
# commit a file with real values in it — this file (.env.example) is the only
# env file that should ever be committed.
#
#
# ── READ THIS BEFORE FILLING ANYTHING IN ────────────────────────────────────
#   1. Only variables prefixed VITE_ are safe to set. Vite inlines every
#      VITE_ variable directly into the JS bundle every visitor downloads.
#      Anything with that prefix is PUBLIC — treat it like it's printed on
#      the homepage, because functionally it is. That's fine for the
#      Supabase URL and anon key specifically — RLS is what actually
#      protects family data once those queries move server-side of RLS,
#      not secrecy of the anon key itself.
#   2. Every other variable below is a SERVER-ONLY secret. It has no effect
#      until Phase 0 of AI-ADMIN-ASSISTANT-PLAN.md adds real server
#      functions (Supabase Edge Functions or Vercel Serverless Functions)
#      to consume it.
#   3. NEVER rename a secret to add the VITE_ prefix "to make it work
#      faster." That is not a shortcut, it's shipping the key to the
#      browser — for this app that means shipping a key that can read every
#      family's kids' records, invoices, and messages to whoever opens
#      devtools.
#
# The admin/parent portals, the store, and useFamilyScope.ts are locked per
# .claude/PROTECTED-AREAS.md. Wiring any of this in for real touches those
# files — that lock gets lifted deliberately when Phase 0 actually starts,
# not worked around.
# =============================================================================


# ── Supabase — Phase 0 ───────────────────────────────────────────────────────
# Dashboard → Project Settings → API. Use the bare project URL, not the
# /rest/v1/ REST endpoint path — the JS client appends that itself.
# Do NOT reuse a project ID from any other Allen Code product (MTT,
# UnderFire AI, Founders Helm, Kirra each have their own; mixing them up
# puts one client's data in another client's project).

# Public — safe to expose. RLS policies (added in Phase 0) are what actually
# protects family data with the anon key, the same way useFamilyScope.ts
# protects it client-side today.
VITE_SUPABASE_URL=https://ivydfwgvulztzmexttzw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml2eWRmd2d2dWx6dHptZXh0dHp3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg4OTY0NzcsImV4cCI6MjEwNDQ3MjQ3N30.pBdEl8fGtyHxGkR7wd9mGA1hvm0qOmlQ0j6L9CIJGKM

# Server-only. Full read/write, bypasses every RLS policy. Lives only in
# Vercel's server env and in Supabase Edge Function secrets — never in a
# browser-reachable file, never logged, never in this repo with a real value.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml2eWRmd2d2dWx6dHptZXh0dHp3Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODg5NjQ3NywiZXhwIjoyMTA0NDcyNDc3fQ.IxnbvYr9o70ZW1U7H5bw_5HfxaW9Yx5647KE78kdG5Y


# ── AI Admin Assistant / OpenRouter — Phase 1+ ──────────────────────────────
# Server-only. The assistant's server function calls OpenRouter for chat,
# speech-to-text, and text-to-speech; the browser never holds this key or
# calls OpenRouter directly. One provider, one key, all three.
OPENROUTER_API_KEY=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
OPENROUTER_SITE_URL=https://auntiestykes.com
OPENROUTER_SITE_NAME=Aunties Tykes Admin Assistant

# Model registry (plan §10) — tier -> ordered, comma-separated OpenRouter model
# IDs, first-choice first, so a provider outage or a repriced model is a
# config change here, not a code change. Three different labs on purpose —
# picked for fit per tier, not all defaulted to one provider. Verified live
# on OpenRouter, September 2026 — reconfirm at https://openrouter.ai/models
# before going live, these roll forward.
AI_MODEL_TIER0_INTENT=inclusionai/ling-3.0-flash-vl
AI_MODEL_TIER1_DRAFTING=qwen/qwen3.8-flash
AI_MODEL_TIER2_ESCALATION=anthropic/claude-haiku-4.5

# Voice (plan §9) — same OpenRouter key, two more model slots. STT is
# Groq-hosted Whisper via OpenRouter's /audio/transcriptions endpoint; TTS is
# OpenRouter's /audio/speech endpoint. Never the browser's own speech APIs —
# that's the thing that breaks on Safari, not these.
AI_MODEL_STT=openai/whisper-large-v3-turbo
AI_MODEL_TTS=openai/gpt-4o-mini-tts

# Safety toggles (plan §7/§8) — ship OFF, turn on deliberately after Phase 1
# has a track record. Do not flip AI_ASSISTANT_ENABLED to true as part of
# the initial deploy. Voice is gated by this same flag — it's an input/output
# channel on the assistant, not a separate feature with its own rollout.
AI_ASSISTANT_ENABLED=false
AI_REQUIRE_CONFIRMATION_FOR_SENDS=true
AI_MAX_SENDS_PER_HOUR=25
AI_MAX_RECIPIENTS_PER_ACTION=10


# ── Transactional email — Phase 0 ────────────────────────────────────────────
# Server-only. Currently "nothing is sent" per ARCHITECTURE.md's demo-seams
# table. Pick ONE provider — don't wire both.
RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=your-token-here
EMAIL_FROM_ADDRESS=melissa@auntiestykes.com
EMAIL_FROM_NAME="Aunties Tykes"


# ── Stripe — billing, Phase 0/later ─────────────────────────────────────────
# Server-only. Today, payments write to the local ledger only; the UI says so
# honestly rather than faking a charge.
STRIPE_SECRET_KEY=sk_live_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
# LOCKED DECISION (Allen Code standard, burned once already on another
# product): the webhook URL registered in the Stripe dashboard MUST include
# www. — Stripe does not follow the 307 redirect a bare apex domain returns.
#   Use:      https://www.auntiestykes.com/api/stripe-webhook
#   Not:      https://auntiestykes.com/api/stripe-webhook


# ── App ──────────────────────────────────────────────────────────────────────
# Public. Used for building absolute links (emails, OG tags, the OpenRouter
# site headers above). Confirm this matches the real launch domain before
# going live — see .claude/LAUNCH-CHECKLIST.md.
VITE_SITE_URL=https://auntiestykes.com

# Note: DEMO_MODE is NOT an env var — it's the boolean flag in
# src/lib/config.ts (free to edit, see PROTECTED-AREAS.md). It stays a code
# flag by design, per that file's own comments, so it isn't listed here.
